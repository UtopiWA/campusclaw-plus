# 首次复制为 .env.team 后填写必需键；已有私有配置不要覆盖，真实值不得提交。
# 团队部署及本机验收共用这些值；修改端口后始终指定同一 .env.team。
COMPOSE_PROJECT_NAME=campusclaw-plus
MYSQL_DATABASE=campusclaw_plus
MYSQL_USER=campusclaw
APP_PORT=18080
MYSQL_HOST_PORT=13306
RABBITMQ_MANAGEMENT_PORT=15673
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# AUTH_JWT_SECRET：至少 32 个 UTF-8 字节的独立随机值。
AUTH_JWT_SECRET=
# OpenAI 兼容地址（含 /v1）、密钥、模型名称和实际输出维度。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
# MCP_AUTH_TOKEN 为独立随机值；加密键为 Base64 编码的 32 个随机字节。
MCP_AUTH_TOKEN=
MCP_TOKEN_ENCRYPTION_KEY=
# RabbitMQ 本地口令；与 Compose 的 rabbitmq 服务和 worker 共用。
RABBITMQ_USER=campusclaw
RABBITMQ_PASSWORD=
# 仅空数据库首次演示改 true；初始化后改回 false，保留原口令供登录和验收。
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=

# 以下可选键仅列名称；需要覆盖时取消注释并补 =值，避免空值覆盖默认。
# MAX_UPLOAD_BYTES（默认 2097152）
# AUTH_JWT_TTL（默认 PT8H）
# QDRANT_COLLECTION（默认 campusclaw_chunks）
# CHAT_REASONING_EFFORT（默认 none）
# RETRIEVAL_CONNECT_TIMEOUT（默认 3s）
# RETRIEVAL_READ_TIMEOUT（默认 30s）
# RETRIEVAL_VECTOR_THRESHOLD（宽召回默认 0.35）
# RETRIEVAL_ANSWER_STRONG_VECTOR_THRESHOLD（问答强向量默认 0.55）
# RETRIEVAL_ANSWER_CORROBORATED_VECTOR_THRESHOLD（双路确认默认 0.45）
# RETRIEVAL_RRF_K（默认 60）
# MCP_ALLOWED_HOSTS（默认 mcp-demo）
# MCP_CONNECT_TIMEOUT（默认 3s）
# MCP_READ_TIMEOUT（默认 10s）
# APP_VERSION（默认 JAR 构建版本；1～64 位字母/数字/点/下划线/短横线，首位字母或数字）
# TESTCONTAINERS_API_VERSION（仅测试需要时指定，如 1.44，不影响应用）
# GRADING_MAX_ATTEMPTS（默认 5）
# GRADING_BACKOFF_BASE（默认 5s）
# GRADING_BACKOFF_MULTIPLIER（默认 2）
# GRADING_BACKOFF_JITTER（默认 0.2）
# GRADING_BACKOFF_MAX（默认 5m）
# GRADING_STALE_TIMEOUT（默认 90s）
# GRADING_OUTBOX_RETRY_DELAY（默认 5s）
# GRADING_PROMPT_VERSION（默认 v5）
# GRADING_OUTBOX_BATCH_SIZE（默认 20）
# GRADING_CONFIRM_TIMEOUT（默认 5s）
# GRADING_PREFETCH（默认 1）
# GRADING_CONCURRENCY（默认 1）
# GRADING_EXCHANGE（默认 grading.events）
# GRADING_TASK_QUEUE（默认 grading.tasks）
# GRADING_DLQ（默认 grading.dlq）
# GRADING_DISPATCH_KEY（默认 grading.dispatch）
# GRADING_RETRY_KEY（默认 grading.retry）
# GRADING_DLQ_KEY（默认 grading.dead-letter）
